# URL pública del dominio (canonical, sitemap, JSON-LD, Open Graph)
NEXT_PUBLIC_SITE_URL=https://publicacionesescort.cl

# Google Analytics 4 (opcional; por defecto usa G-F6EQP3QM1C)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-F6EQP3QM1C

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Panel admin privado: /admin/login (requiere usuario con app_metadata.role = "admin")
# Ver supabase/01-admin-schema.sql, 02-seed-anuncio-costos.sql, 03-admin-usuario.sql

# Anthropic (solo servidor) — flyer de promociones Skokka con IA
# Console: https://console.anthropic.com/ → API keys
# NUNCA uses prefijo NEXT_PUBLIC_ (la key no debe ir al navegador)
ANTHROPIC_API_KEY=sk-ant-api03-...

# ⚠️ NUNCA pongas el SERVICE_ROLE_KEY con prefijo NEXT_PUBLIC, ni lo subas al repo.
# Solo se usa en el servidor para tareas administrativas (no se necesita para este catálogo público).
